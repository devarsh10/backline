---
import { env } from 'cloudflare:workers';
import { getAllEquipment } from '../lib/equipmentDb';
import { RENTAL_DATES_COOKIE, parseRentalDatesCookie, formatDateChip } from '../lib/rentalDates';

const equipment = await getAllEquipment(env.DB);

const currentPath = Astro.url.pathname;
const rentalDates = parseRentalDatesCookie(Astro.cookies.get(RENTAL_DATES_COOKIE)?.value);

const navCategories = [
  { href: '/equipment/drums',             label: 'Drum Kits & Cymbals' },
  { href: '/equipment/drum-accessories',  label: 'Drum Accessories' },
  { href: '/equipment/amplifiers',        label: 'Amplifiers & Cabinets' },
  { href: '/equipment/keyboards',         label: 'Pianos & Keyboards' },
  { href: '/equipment/percussion',        label: 'Percussion' },
  { href: '/equipment/miscellaneous',     label: 'Miscellaneous' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const equipmentActive = currentPath.startsWith('/equipment');

// Lightweight catalogue index for the client-side global search.
const searchIndex = equipment.map(({ slug, name, brand, category, subcategory, pricePerDay, available, featured, image }) => (
  { slug, name, brand, category, subcategory, pricePerDay, available, featured, image }
));
---

<header class="nav-bar" id="site-nav">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Backline India — Home">
      <span class="nav-logo-mark">B</span>
      <span class="nav-logo-text">Backline India</span>
    </a>

    <!-- Desktop links -->
    <nav class="nav-links" aria-label="Main navigation">
      <!-- Equipment dropdown -->
      <div class="nav-dropdown-group" id="nav-dropdown-group">
        <button type="button" class={`nav-link nav-dropdown-trigger ${equipmentActive ? 'active' : ''}`} id="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Rental Equipment
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="nav-dropdown-menu-inner">
            {navCategories.map(cat => (
              <a href={cat.href} class={`nav-dropdown-item ${currentPath.startsWith(cat.href) ? 'active' : ''}`} role="menuitem">
                {cat.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- Right cluster -->
    <div class="nav-cta-cluster">
      <!-- Global search -->
      <div class="nav-search" id="nav-search">
        <script id="nav-search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
        <button type="button" class="nav-search-toggle" id="nav-search-toggle" aria-label="Search equipment">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <div class="nav-search-box">
          <svg class="nav-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="search"
            id="nav-search-input"
            class="nav-search-input"
            placeholder="Search equipment…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search equipment"
          />
        </div>
        <div class="nav-search-results" id="nav-search-results"></div>
      </div>

      <!-- Rental dates pill -->
      <div class="nav-dates-group" id="nav-dates-group">
        <div class="nav-dates-pill">
          <button type="button" class="nav-dates-trigger" id="nav-dates-trigger" aria-haspopup="true" aria-expanded="false">
            {rentalDates ? (
              <>
                <span class="nav-date-seg">
                  <span class="nav-date-seg-label">Start</span>
                  <span class="nav-date-seg-value">{formatDateChip(rentalDates.from)}</span>
                </span>
                <span class="nav-date-divider"></span>
                <span class="nav-date-seg">
                  <span class="nav-date-seg-label">End</span>
                  <span class="nav-date-seg-value">{formatDateChip(rentalDates.to)}</span>
                </span>
              </>
            ) : (
              <span class="nav-dates-simple">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span class="nav-dates-simple-label">Select dates</span>
              </span>
            )}
          </button>
          {rentalDates && (
            <button type="button" class="nav-dates-clear" id="nav-dates-clear" aria-label="Clear dates">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          )}
        </div>
        <div class="nav-dates-menu" role="menu">
          <div class="nav-dates-menu-inner">
            <div class="nav-dates-field">
              <label for="nav-date-from">Start date</label>
              <input type="date" id="nav-date-from" value={rentalDates?.from ?? ''} />
            </div>
            <div class="nav-dates-field">
              <label for="nav-date-to">End date</label>
              <input type="date" id="nav-date-to" value={rentalDates?.to ?? ''} />
            </div>
            <button type="button" class="btn-primary btn-sm nav-dates-update" id="nav-dates-update">Update dates</button>
          </div>
        </div>
      </div>

      <!-- Account button -->
      <a href="/account" class={`nav-account-btn ${isActive('/account') ? 'active' : ''}`} aria-label="My account">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.418 3.582-7 8-7s8 2.582 8 7"/>
        </svg>
      </a>

      <!-- Cart button -->
      <a href="/cart" class="nav-cart-btn" aria-label="View cart">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span id="cart-count" class="cart-badge" style="display:none;" aria-label="items in cart"></span>
      </a>

      <!-- Mobile menu button -->
      <button class="nav-menu-btn" id="nav-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav>
      <p class="mobile-menu-section">Equipment</p>
      {navCategories.map(cat => (
        <a href={cat.href} class={`mobile-nav-link ${currentPath.startsWith(cat.href) ? 'active' : ''}`}>
          {cat.label}
        </a>
      ))}
      <a href="/about" class={`mobile-nav-link ${isActive('/about') ? 'active' : ''}`}>About</a>
      <a href="/account" class={`mobile-nav-link ${isActive('/account') ? 'active' : ''}`}>My Account</a>
      <a href="/cart" class="mobile-nav-link">Cart</a>
      <a href="/contact" class="mobile-nav-link">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav-bar {
    position: sticky; top: 0; z-index: 100;
    background-color: rgba(13,13,13,0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 24px;
    height: 60px; display: flex; align-items: center; gap: 8px;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; flex-shrink: 0;
  }
  .nav-logo-mark {
    width: 28px; height: 28px;
    background-color: var(--color-ink); color: var(--color-on-primary);
    border-radius: 6px; display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700; letter-spacing: -0.02em;
  }
  .nav-logo-text { font-size: 16px; font-weight: 600; color: var(--color-ink); letter-spacing: -0.03em; }

  .nav-links { display: flex; align-items: center; gap: 2px; margin-left: 16px; flex: 1; }

  /* Dropdown group */
  .nav-dropdown-group { position: relative; }
  .nav-dropdown-trigger {
    display: flex; align-items: center; gap: 4px;
    background: none; border: none; cursor: pointer; font-family: var(--font-sans);
  }
  .chevron { transition: transform 0.18s; }
  .nav-dropdown-group:hover .chevron,
  .nav-dropdown-group.open .chevron { transform: rotate(180deg); }

  .nav-dropdown-menu {
    position: absolute; top: 100%; left: 0;
    padding-top: 8px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.15s;
    z-index: 200; min-width: 240px;
  }
  .nav-dropdown-menu-inner {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
    padding: 6px;
  }
  .nav-dropdown-group:hover .nav-dropdown-menu,
  .nav-dropdown-group:focus-within .nav-dropdown-menu,
  .nav-dropdown-group.open .nav-dropdown-menu {
    opacity: 1; pointer-events: auto;
  }
  .nav-dropdown-item {
    display: block; padding: 8px 12px;
    font-size: 13px; color: var(--color-body);
    text-decoration: none; border-radius: var(--radius-sm);
    transition: background-color 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .nav-dropdown-item:hover { background-color: var(--color-canvas-soft-2); color: var(--color-ink); }
  .nav-dropdown-item.active { color: var(--color-ink); font-weight: 500; }

  .nav-link {
    display: flex; align-items: center; padding: 6px 10px;
    font-size: 14px; color: var(--color-body); text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.12s, color 0.12s;
  }
  .nav-link:hover { background-color: var(--color-canvas-soft-2); color: var(--color-ink); }
  .nav-link.active { color: var(--color-ink); font-weight: 500; }

  .nav-cta-cluster { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-shrink: 0; }

  /* Rental dates pill — a single capsule (border/background/radius all on one
     container), not separate chips, per the reference the user shared. */
  .nav-dates-group { position: relative; }
  .nav-dates-pill {
    display: flex; align-items: stretch;
    background-color: var(--color-accent-soft); border: 1px solid var(--color-accent-deep);
    border-radius: var(--radius-full); overflow: hidden;
  }
  .nav-dates-pill:hover { background-color: var(--color-accent-deep); }
  .nav-dates-pill:hover .nav-date-seg-label,
  .nav-dates-pill:hover .nav-date-seg-value,
  .nav-dates-pill:hover .nav-dates-simple,
  .nav-dates-pill:hover .nav-dates-simple svg,
  .nav-dates-pill:hover .nav-dates-clear { color: #fff; }
  .nav-dates-pill:hover .nav-date-divider { background-color: rgba(255,255,255,0.5); }
  .nav-dates-trigger {
    display: flex; align-items: stretch;
    background: none; border: none; padding: 0; cursor: pointer; font-family: var(--font-sans);
  }
  .nav-date-seg { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 0; padding: 5px 12px; white-space: nowrap; }
  .nav-date-seg-label { font-size: 10px; color: var(--color-accent-deep); opacity: 0.75; line-height: 1.2; }
  .nav-date-seg-value { font-size: 12px; font-weight: 600; color: var(--color-accent-deep); line-height: 1.2; }
  .nav-date-divider { width: 1px; background-color: var(--color-accent-deep); opacity: 0.35; margin: 6px 0; }
  .nav-dates-simple {
    display: flex; align-items: center; gap: 6px; padding: 6px 14px;
    font-size: 12px; font-weight: 600; color: var(--color-accent-deep); white-space: nowrap;
  }
  .nav-dates-simple svg { color: var(--color-accent-deep); }
  .nav-dates-clear {
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; border-left: 1px solid var(--color-accent-deep);
    color: var(--color-accent-deep); cursor: pointer; padding: 0 10px;
  }
  .nav-dates-menu {
    position: absolute; top: 100%; right: 0;
    padding-top: 8px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.15s;
    z-index: 200; min-width: 220px;
  }
  .nav-dates-group.open .nav-dates-menu { opacity: 1; pointer-events: auto; }
  .nav-dates-menu-inner {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10); padding: 14px; display: flex; flex-direction: column; gap: 10px;
  }
  .nav-dates-field { display: flex; flex-direction: column; gap: 4px; }
  .nav-dates-field label { font-size: 11px; color: var(--color-mute); }
  .nav-dates-field input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 13px; font-family: var(--font-sans); height: 34px; padding: 0 8px;
    color-scheme: dark; width: 100%;
  }
  .nav-dates-update { width: 100%; justify-content: center; }

  /* Global search */
  .nav-search { position: relative; display: flex; align-items: center; }
  .nav-search-toggle {
    display: none; background: none; border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm); padding: 7px; cursor: pointer; color: var(--color-body);
    line-height: 0;
  }
  .nav-search-box {
    display: flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    padding: 0 10px; width: 190px; height: 34px;
    transition: border-color 0.15s, width 0.15s, background-color 0.15s;
  }
  .nav-search-box:focus-within {
    border-color: var(--color-hairline-strong);
    background-color: rgba(255,255,255,0.10);
    width: 240px;
  }
  .nav-search-icon { color: var(--color-mute); flex-shrink: 0; }
  .nav-search-input {
    flex: 1; min-width: 0; border: none; outline: none; background: transparent;
    font-size: 13px; color: var(--color-ink); font-family: var(--font-sans);
  }
  .nav-search-input::placeholder { color: var(--color-mute); }
  .nav-search-input::-webkit-search-cancel-button { display: none; }

  .nav-search-results {
    display: none;
    position: absolute; top: 100%; right: 0; margin-top: 8px;
    width: 340px; max-height: 420px; overflow-y: auto;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgba(0,0,0,0.16);
    z-index: 200; padding: 6px;
  }
  .nav-search-results.open { display: block; }

  :global(.nsr-meta) { font-size: 11px; color: var(--color-mute); padding: 6px 8px 4px; }
  :global(.nsr-item) {
    display: flex; align-items: center; gap: 10px;
    padding: 8px; border-radius: var(--radius-sm);
    text-decoration: none; color: inherit;
  }
  :global(.nsr-item:hover) { background-color: var(--color-canvas-soft-2); }
  :global(.nsr-thumb) {
    width: 40px; height: 40px; flex-shrink: 0; border-radius: var(--radius-sm);
    background-color: var(--color-canvas-soft-2);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  :global(.nsr-thumb img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.nsr-info) { flex: 1; min-width: 0; }
  :global(.nsr-name) {
    font-size: 13px; font-weight: 500; color: var(--color-ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  :global(.nsr-sub) { font-size: 11px; color: var(--color-mute); }
  :global(.nsr-price) { font-size: 12px; font-weight: 600; color: var(--color-ink); flex-shrink: 0; }
  :global(.nsr-unavail) { font-size: 10px; font-weight: 600; color: #d4a017; flex-shrink: 0; }
  :global(.nsr-empty) { padding: 20px 12px; text-align: center; font-size: 13px; color: var(--color-mute); }
  :global(.nsr-empty a) { color: var(--color-link); }

  .nav-cart-btn, .nav-account-btn {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .nav-cart-btn:hover, .nav-account-btn:hover { border-color: var(--color-hairline-strong); background-color: var(--color-canvas-soft-2); }
  .nav-account-btn.active { border-color: var(--color-ink); background-color: var(--color-canvas-soft-2); }
  .cart-badge {
    position: absolute; top: -6px; right: -6px;
    min-width: 16px; height: 16px;
    background-color: #1a8fa8; color: #ffffff;
    font-size: 10px; font-weight: 700; border-radius: var(--radius-full);
    display: flex; align-items: center; justify-content: center;
    padding: 0 3px; line-height: 1;
  }
  .nav-menu-btn {
    display: none; background: none;
    border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    padding: 6px; cursor: pointer; color: var(--color-ink); line-height: 0;
  }

  .mobile-menu {
    display: none; border-top: 1px solid var(--color-hairline);
    background-color: var(--color-canvas); padding: 12px 24px 16px;
  }
  .mobile-menu.open { display: block; }
  .mobile-menu-section {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-mute);
    margin: 4px 0 6px; padding: 0;
  }
  .mobile-nav-link {
    display: block; padding: 10px 0;
    font-size: 14px; color: var(--color-body);
    text-decoration: none; border-bottom: 1px solid var(--color-hairline);
  }
  .mobile-nav-link:last-child { border-bottom: none; }
  .mobile-nav-link.active { color: var(--color-ink); font-weight: 500; }
  .mobile-nav-link:hover { color: var(--color-ink); }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-menu-btn { display: flex; }
  }
  @media (max-width: 640px) {
    .nav-inner { padding: 0 16px; }
    .nav-search-toggle { display: flex; align-items: center; justify-content: center; }
    .nav-search-box { display: none; }
    .nav-search.open .nav-search-box {
      display: flex; position: absolute; top: 44px; right: 0; width: 260px;
      background-color: var(--color-canvas); z-index: 210;
    }
    .nav-search.open .nav-search-toggle { display: none; }
    .nav-search-results { width: 280px; right: -8px; }
    .nav-date-seg-label { display: none; }
    .nav-date-seg { padding: 5px 8px; }
    .nav-dates-simple-label { display: none; }
    .nav-dates-menu { right: -40px; }
  }
</style>

<script>
  import { updateCartBadge } from '../scripts/cart';
  import { searchItems, type SearchableItem } from '../scripts/search';

  updateCartBadge();

  const btn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('aria-hidden', String(!open));
  });

  // Equipment dropdown — hover works via CSS; this handles tap/click for touch + keyboard.
  const dropdownGroup = document.getElementById('nav-dropdown-group');
  const dropdownTrigger = document.getElementById('nav-dropdown-trigger');
  dropdownTrigger?.addEventListener('click', () => {
    const isOpen = dropdownGroup?.classList.toggle('open');
    dropdownTrigger.setAttribute('aria-expanded', String(isOpen));
  });
  document.addEventListener('click', (e) => {
    if (dropdownGroup && !dropdownGroup.contains(e.target as Node)) {
      dropdownGroup.classList.remove('open');
      dropdownTrigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Rental dates pill
  const datesGroup = document.getElementById('nav-dates-group');
  const datesTrigger = document.getElementById('nav-dates-trigger');
  const datesFrom = document.getElementById('nav-date-from') as HTMLInputElement;
  const datesTo = document.getElementById('nav-date-to') as HTMLInputElement;
  const datesUpdateBtn = document.getElementById('nav-dates-update');

  const todayIso = new Date().toISOString().slice(0, 10);
  datesFrom.min = todayIso;
  datesTo.min = datesFrom.value || todayIso;

  datesTrigger?.addEventListener('click', () => {
    const isOpen = datesGroup?.classList.toggle('open');
    datesTrigger.setAttribute('aria-expanded', String(isOpen));
  });
  document.addEventListener('click', (e) => {
    if (datesGroup && !datesGroup.contains(e.target as Node)) {
      datesGroup.classList.remove('open');
      datesTrigger?.setAttribute('aria-expanded', 'false');
    }
  });
  datesFrom.addEventListener('change', () => {
    if (!datesTo.value || datesTo.value < datesFrom.value) datesTo.value = datesFrom.value;
    datesTo.min = datesFrom.value;
  });
  datesUpdateBtn?.addEventListener('click', () => {
    if (!datesFrom.value || !datesTo.value) return;
    document.cookie = `rental_dates=${datesFrom.value}_${datesTo.value}; path=/; max-age=${60 * 60 * 24 * 90}; SameSite=Lax`;
    window.location.reload();
  });
  document.getElementById('nav-dates-clear')?.addEventListener('click', () => {
    document.cookie = 'rental_dates=; path=/; max-age=0';
    window.location.reload();
  });

  // Global search
  const allItems: SearchableItem[] = JSON.parse(
    document.getElementById('nav-search-data')!.textContent!
  );

  const searchWrap = document.getElementById('nav-search')!;
  const searchToggle = document.getElementById('nav-search-toggle');
  const searchInput = document.getElementById('nav-search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('nav-search-results')!;

  function esc(s: string) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderResults(query: string) {
    if (!query.trim()) { resultsEl.classList.remove('open'); resultsEl.innerHTML = ''; return; }

    const matches = searchItems(allItems, query, 8);

    if (matches.length === 0) {
      resultsEl.innerHTML = `
        <div class="nsr-empty">
          No matches for "${esc(query)}" —
          <a href="/contact">ask us about it</a>
        </div>`;
      resultsEl.classList.add('open');
      return;
    }

    resultsEl.innerHTML = `
      <div class="nsr-meta">${matches.length} result${matches.length !== 1 ? 's' : ''}</div>
      ${matches.map(item => {
        const thumb = item.image
          ? `<img src="${esc(item.image)}" alt="" loading="lazy" />`
          : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.25"><path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/></svg>`;
        return `
          <a class="nsr-item" href="/equipment/${esc(item.category)}/${esc(item.slug)}">
            <span class="nsr-thumb">${thumb}</span>
            <span class="nsr-info">
              <span class="nsr-name">${esc(item.name)}</span>
              <span class="nsr-sub">${esc(item.brand)} · ${esc(item.subcategory)}</span>
            </span>
            ${item.available
              ? `<span class="nsr-price">₹${item.pricePerDay.toLocaleString('en-IN')}/day</span>`
              : `<span class="nsr-unavail">Unavailable</span>`}
          </a>`;
      }).join('')}
    `;
    resultsEl.classList.add('open');
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => renderResults(searchInput.value), 150);
  });

  searchToggle?.addEventListener('click', () => {
    searchWrap.classList.toggle('open');
    if (searchWrap.classList.contains('open')) searchInput?.focus();
  });

  document.addEventListener('click', (e) => {
    if (!searchWrap.contains(e.target as Node)) {
      resultsEl.classList.remove('open');
      if (window.innerWidth <= 640) searchWrap.classList.remove('open');
    }
  });
</script>
