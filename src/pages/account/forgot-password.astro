---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Forgot Password" description="Reset your Backline India account password." noIndex={true}>
  <div class="login-container">
    <div class="login-card">
      <h1 class="display-md">Forgot password</h1>
      <p class="login-sub" id="fp-sub">Enter your account email and we'll send you a reset code.</p>

      <form id="fp-email-form">
        <div class="form-group">
          <label class="form-label" for="fp-email">Email</label>
          <input class="form-input" type="email" id="fp-email" name="email" required autofocus />
        </div>
        <p id="fp-email-error" class="login-error" style="display:none;"></p>
        <button type="submit" class="btn-primary login-btn">Send reset code</button>
      </form>

      <form id="fp-code-form" hidden>
        <div class="form-group">
          <label class="form-label" for="fp-code">Reset code</label>
          <input class="form-input" type="text" id="fp-code" name="code" inputmode="numeric" maxlength="6" required autofocus />
        </div>
        <p id="fp-code-error" class="login-error" style="display:none;"></p>
        <button type="submit" class="btn-primary login-btn">Verify code</button>
      </form>

      <form id="fp-password-form" hidden>
        <div class="form-group">
          <label class="form-label" for="fp-password">New password</label>
          <input class="form-input" type="password" id="fp-password" name="password" minlength="8" required autofocus />
        </div>
        <div class="form-group">
          <label class="form-label" for="fp-password-confirm">Confirm new password</label>
          <input class="form-input" type="password" id="fp-password-confirm" name="passwordConfirm" minlength="8" required />
        </div>
        <p id="fp-password-error" class="login-error" style="display:none;"></p>
        <button type="submit" class="btn-primary login-btn">Reset password</button>
      </form>

      <p class="login-footer"><a href="/account/login">Back to log in</a></p>
    </div>
  </div>
</Layout>

<style>
  .login-container { max-width: 400px; margin: 60px auto; padding: 0 24px; }
  .login-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); padding: 32px;
  }
  .login-sub { font-size: 13px; color: var(--color-mute); margin: 4px 0 20px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 16px; }
  .form-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans); height: 40px; padding: 0 12px; width: 100%;
  }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .login-btn { width: 100%; justify-content: center; }
  .login-error { font-size: 13px; color: var(--color-error); margin: -4px 0 12px; }
  .login-footer { font-size: 13px; color: var(--color-mute); text-align: center; margin: 20px 0 0; }
</style>

<script>
  const emailForm = document.getElementById('fp-email-form') as HTMLFormElement;
  const codeForm = document.getElementById('fp-code-form') as HTMLFormElement;
  const passwordForm = document.getElementById('fp-password-form') as HTMLFormElement;
  const sub = document.getElementById('fp-sub')!;
  let submittedEmail = '';
  let verifiedCode = '';

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('fp-email') as HTMLInputElement).value.trim();
    const errorEl = document.getElementById('fp-email-error')!;
    errorEl.style.display = 'none';

    const res = await fetch('/api/account/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      errorEl.textContent = data.error || 'Something went wrong. Please try again.';
      errorEl.style.display = 'block';
      return;
    }

    submittedEmail = email;
    emailForm.hidden = true;
    codeForm.hidden = false;
    sub.textContent = `If an account exists for ${email}, we've sent a reset code there. Enter it below.`;
  });

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('fp-code') as HTMLInputElement).value.trim();
    const errorEl = document.getElementById('fp-code-error')!;
    errorEl.style.display = 'none';

    const res = await fetch('/api/account/verify-reset-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: submittedEmail, code }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      errorEl.textContent = data.error || 'Incorrect or expired code.';
      errorEl.style.display = 'block';
      return;
    }

    verifiedCode = code;
    codeForm.hidden = true;
    passwordForm.hidden = false;
    sub.textContent = 'Code verified. Choose your new password.';
  });

  passwordForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (document.getElementById('fp-password') as HTMLInputElement).value;
    const passwordConfirm = (document.getElementById('fp-password-confirm') as HTMLInputElement).value;
    const errorEl = document.getElementById('fp-password-error')!;
    errorEl.style.display = 'none';

    if (password !== passwordConfirm) {
      errorEl.textContent = 'Passwords do not match.';
      errorEl.style.display = 'block';
      return;
    }

    const res = await fetch('/api/account/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: submittedEmail, code: verifiedCode, password }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      errorEl.textContent = data.error || 'Could not reset password. Please try again.';
      errorEl.style.display = 'block';
      return;
    }

    window.location.href = '/account';
  });
</script>
