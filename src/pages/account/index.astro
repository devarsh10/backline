---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { verifyCustomerSessionToken } from '../../lib/customerAuth';
import { getCustomerById } from '../../lib/customerDb';
import { getOrdersByCustomerId } from '../../lib/db';

const sessionToken = Astro.cookies.get('customer_session')?.value;
const customerId = await verifyCustomerSessionToken(sessionToken, env.CUSTOMER_SESSION_SECRET);
if (!customerId) return Astro.redirect('/account/login?redirect=/account');

const account = await getCustomerById(env.DB, customerId);
if (!account) return Astro.redirect('/account/login?redirect=/account');

const orders = await getOrdersByCustomerId(env.DB, customerId);

const STATUS_LABELS: Record<string, string> = {
  order_placed: 'Order Placed',
  payment_received: 'Payment Received',
  out_for_delivery: 'Out for Delivery',
  delivered: 'Delivered',
};

function fp(n: number) { return `₹${n.toLocaleString('en-IN')}`; }
const dateOpts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' };
---

<Layout title="My Orders" description="Your Backline India rental order history." noIndex={true}>
  <div class="page-container">
    <div class="orders-header">
      <p class="page-sub">Signed in as {account.name}</p>
      <button type="button" class="btn-secondary" id="logout-btn">Log out</button>
    </div>

    <h2 class="section-heading">My Account</h2>
    <div class="account-card">
      <div class="account-field">
        <label for="acc-name">Name</label>
        <input type="text" id="acc-name" class="form-input" value={account.name} />
      </div>
      <div class="account-field">
        <label for="acc-phone">Phone</label>
        <input type="tel" id="acc-phone" class="form-input" value={account.phone ?? ''} />
      </div>
      <div class="account-field">
        <label for="acc-email">Email</label>
        <input type="email" id="acc-email" class="form-input" value={account.email} />
      </div>
      <button type="button" class="btn-primary" id="acc-save">Save changes</button>
      <p id="acc-msg" class="account-msg"></p>

      <div id="acc-otp-block" class="account-otp-block" hidden>
        <p class="account-otp-note">We sent a verification code to <strong id="acc-otp-email"></strong>. Enter it below to confirm your new email.</p>
        <div class="account-otp-row">
          <input type="text" id="acc-otp-code" class="form-input" placeholder="6-digit code" inputmode="numeric" maxlength="6" />
          <button type="button" class="btn-secondary" id="acc-otp-confirm">Confirm email</button>
        </div>
      </div>
    </div>

    <h2 class="section-heading orders-heading">My Orders</h2>

    {orders.length === 0 ? (
      <p class="loading-note">No orders yet — <a href="/#categories">browse equipment</a> to place your first one.</p>
    ) : (
      <div class="orders-grid">
        {orders.map(o => {
          const items = JSON.parse(o.items_json).map((l: any) => `${l.name} ×${l.quantity}`).join(', ');
          const from = new Date(o.rental_start_date).toLocaleDateString('en-IN', dateOpts);
          const to = new Date(o.rental_end_date).toLocaleDateString('en-IN', dateOpts);
          return (
            <div class={`order-card status-${o.status}`}>
              <div class="oc-top">
                <span class="oc-ref">{o.order_ref}</span>
                <span class="oc-total">{fp(o.total_amount)}</span>
              </div>
              <div class="oc-items">{items}</div>
              <div class="oc-dates">{from} – {to}</div>
              <span class="oc-status-pill">{STATUS_LABELS[o.status] || o.status}</span>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>

<style>
  .page-container { max-width: 1280px; margin: 0 auto; padding: 32px 16px 80px; }
  .orders-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
  .page-sub { color: var(--color-mute); font-size: 14px; margin: 0; }
  .loading-note { color: var(--color-mute); font-size: 14px; }
  .section-heading { font-size: 20px; font-weight: 600; margin: 0 0 16px; }

  .account-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg);
    padding: 20px; max-width: 480px;
  }
  .account-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
  .account-field label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans); height: 40px; padding: 0 12px; width: 100%;
  }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .account-msg { font-size: 13px; color: var(--color-accent-deep); margin: 10px 0 0; min-height: 16px; }
  .account-otp-block { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-hairline); }
  .account-otp-note { font-size: 13px; color: var(--color-body); margin: 0 0 10px; }
  .account-otp-row { display: flex; gap: 8px; }
  .account-otp-row .form-input { max-width: 160px; }
  .orders-heading { margin-top: 36px; }

  .orders-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px; margin-top: 20px;
  }
  .order-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-hairline-strong); border-radius: var(--radius-lg);
    padding: 16px; display: flex; flex-direction: column; gap: 10px;
  }
  .order-card.status-payment_received { border-left-color: var(--color-accent-deep); }
  .order-card.status-out_for_delivery { border-left-color: var(--color-warning); }
  .order-card.status-delivered { border-left-color: var(--color-accent); }

  .oc-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .oc-ref { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--color-ink); letter-spacing: 0.02em; }
  .oc-total { font-size: 16px; font-weight: 700; color: var(--color-ink); white-space: nowrap; }
  .oc-items { font-size: 13px; color: var(--color-body); line-height: 1.5; padding: 8px 0; border-top: 1px solid var(--color-hairline); border-bottom: 1px solid var(--color-hairline); }
  .oc-dates { font-size: 13px; color: var(--color-body); }
  .oc-status-pill {
    align-self: flex-start; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-mute); background-color: var(--color-canvas-soft-2); padding: 3px 10px; border-radius: var(--radius-full);
  }
</style>

<script>
  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await fetch('/api/account/logout', { method: 'POST' });
    window.location.href = '/';
  });

  const accMsg = document.getElementById('acc-msg')!;
  const otpBlock = document.getElementById('acc-otp-block')!;
  const otpEmailLabel = document.getElementById('acc-otp-email')!;

  document.getElementById('acc-save')!.addEventListener('click', async () => {
    const name = (document.getElementById('acc-name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('acc-phone') as HTMLInputElement).value.trim();
    const email = (document.getElementById('acc-email') as HTMLInputElement).value.trim();
    accMsg.textContent = '';

    const res = await fetch('/api/account/update-profile', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ name, phone, email }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      accMsg.textContent = data.error || 'Something went wrong';
      accMsg.style.color = 'var(--color-error)';
      return;
    }

    if (data.pendingEmail) {
      otpEmailLabel.textContent = data.pendingEmail;
      otpBlock.hidden = false;
      accMsg.style.color = 'var(--color-accent-deep)';
      accMsg.textContent = 'Name and phone saved.';
    } else {
      otpBlock.hidden = true;
      accMsg.style.color = 'var(--color-accent-deep)';
      accMsg.textContent = 'Saved.';
    }
  });

  document.getElementById('acc-otp-confirm')!.addEventListener('click', async () => {
    const code = (document.getElementById('acc-otp-code') as HTMLInputElement).value.trim();
    const res = await fetch('/api/account/confirm-email-change', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      accMsg.style.color = 'var(--color-error)';
      accMsg.textContent = data.error || 'Incorrect or expired code';
      return;
    }

    otpBlock.hidden = true;
    accMsg.style.color = 'var(--color-accent-deep)';
    accMsg.textContent = 'Email updated.';
  });
</script>
