---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Log In" description="Log in to your Backline India account.">
  <div class="login-container">
    <div class="login-card">
      <h1 class="display-md">Log in</h1>
      <p class="login-sub">See your rental order history.</p>
      <form id="login-form">
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input class="form-input" type="email" id="email" name="email" required autofocus />
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-input" type="password" id="password" name="password" required />
        </div>
        <p id="login-error" class="login-error" style="display:none;"></p>
        <button type="submit" class="btn-primary login-btn">Log in</button>
      </form>
      <p class="login-footer">Don't have an account? <a href="/account/signup">Create one</a></p>
    </div>
  </div>
</Layout>

<style>
  .login-container { max-width: 400px; margin: 60px auto; padding: 0 24px; }
  .login-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); padding: 32px;
  }
  .login-sub { font-size: 13px; color: var(--color-mute); margin: 4px 0 20px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 16px; }
  .form-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans); height: 40px; padding: 0 12px; width: 100%;
  }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .login-btn { width: 100%; justify-content: center; }
  .login-error { font-size: 13px; color: var(--color-error); margin: -4px 0 12px; }
  .login-footer { font-size: 13px; color: var(--color-mute); text-align: center; margin: 20px 0 0; }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const redirectTo = params.get('redirect') || '/';

  document.getElementById('login-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const errorEl = document.getElementById('login-error')!;
    errorEl.style.display = 'none';

    const res = await fetch('/api/account/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      if (data.needsVerification) {
        window.location.href = '/account/verify?email=' + encodeURIComponent(email);
        return;
      }
      errorEl.textContent = data.error || 'Login failed. Please try again.';
      errorEl.style.display = 'block';
      return;
    }
    window.location.href = redirectTo;
  });
</script>
