---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Create Account" description="Create a Backline India account to see your rental order history.">
  <div class="login-container">
    <div class="login-card">
      <h1 class="display-md">Create account</h1>
      <p class="login-sub">See your past and current rental orders in one place.</p>
      <form id="signup-form">
        <div class="form-group">
          <label class="form-label" for="name">Name</label>
          <input class="form-input" type="text" id="name" name="name" required autofocus />
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input class="form-input" type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="phone">Phone (optional)</label>
          <input class="form-input" type="tel" id="phone" name="phone" />
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-input" type="password" id="password" name="password" required minlength="8" />
        </div>
        <p id="signup-error" class="login-error" style="display:none;"></p>
        <button type="submit" class="btn-primary login-btn">Create account</button>
      </form>

      <div class="oauth-divider"><span>or</span></div>
      <a class="google-btn" href="/api/account/google-login">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.9-2.26 5.36-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </a>

      <p class="login-footer">Already have an account? <a href="/account/login">Log in</a></p>
    </div>
  </div>
</Layout>

<style>
  .login-container { max-width: 400px; margin: 60px auto; padding: 0 24px; }
  .login-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); padding: 32px;
  }
  .login-sub { font-size: 13px; color: var(--color-mute); margin: 4px 0 20px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 16px; }
  .form-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans); height: 40px; padding: 0 12px; width: 100%;
  }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .login-btn { width: 100%; justify-content: center; }
  .login-error { font-size: 13px; color: var(--color-error); margin: -4px 0 12px; }
  .login-footer { font-size: 13px; color: var(--color-mute); text-align: center; margin: 20px 0 0; }

  .oauth-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: var(--color-mute); font-size: 12px; }
  .oauth-divider::before, .oauth-divider::after { content: ''; flex: 1; height: 1px; background-color: var(--color-hairline); }
  .google-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 42px;
    border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background-color: var(--color-canvas);
    color: var(--color-ink); font-size: 14px; font-weight: 500; text-decoration: none;
  }
  .google-btn:hover { border-color: var(--color-hairline-strong); }
</style>

<script>
  document.getElementById('signup-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const phone = (document.getElementById('phone') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const errorEl = document.getElementById('signup-error')!;
    errorEl.style.display = 'none';

    const res = await fetch('/api/account/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email, phone, password }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      errorEl.textContent = data.error || 'Signup failed. Please try again.';
      errorEl.style.display = 'block';
      return;
    }
    window.location.href = '/account/verify?email=' + encodeURIComponent(email);
  });
</script>
