---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/equipment';
---

<Layout title="Equipment Stock" noIndex={true} manifest="/admin.webmanifest" webAppTitle="BL Admin">
  <div class="page-container">
    <div class="admin-tabs">
      <a href="/admin/orders" class="admin-tab">Orders</a>
      <a href="/admin/equipment" class="admin-tab active">Equipment Stock</a>
    </div>
    <div class="page-header-row">
      <div>
        <h1 class="display-lg">Equipment Stock</h1>
        <p class="page-sub">Set how many units of each item you actually own, and adjust prices. Customers can never book more units than this for the same dates.</p>
      </div>
      <button type="button" class="btn-primary" id="add-item-toggle">+ Add New Item</button>
    </div>

    <script id="admin-categories-data" type="application/json" set:html={JSON.stringify(categories)} />

    <div id="add-item-panel" class="add-item-panel" hidden>
      <h2 class="add-item-title">Add New Item</h2>
      <div class="add-item-grid">
        <div class="form-group">
          <label class="form-label" for="ai-name">Name *</label>
          <input class="form-input" type="text" id="ai-name" placeholder="e.g. Roland KC-600 Stereo Mixing Keyboard Amp" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-brand">Brand *</label>
          <input class="form-input" type="text" id="ai-brand" placeholder="e.g. Roland" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-category">Category *</label>
          <select class="form-input" id="ai-category"></select>
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-subcategory">Subcategory *</label>
          <input class="form-input" type="text" id="ai-subcategory" placeholder="e.g. Keyboard Amplifiers & Cabinets" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-price">Price per day (₹) *</label>
          <input class="form-input" type="number" id="ai-price" min="1" placeholder="e.g. 1500" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-min-days">Minimum rental days *</label>
          <input class="form-input" type="number" id="ai-min-days" min="1" value="1" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-units">Units owned *</label>
          <input class="form-input" type="number" id="ai-units" min="0" value="1" />
        </div>
        <div class="form-group">
          <label class="form-label" for="ai-image">Image URL (optional)</label>
          <input class="form-input" type="text" id="ai-image" placeholder="/images/equipment/..." />
        </div>
        <div class="form-group add-item-full">
          <label class="form-label" for="ai-included">What's included (one per line)</label>
          <textarea class="form-input" id="ai-included" rows="3" placeholder="Power cable&#10;Stand"></textarea>
        </div>
        <div class="form-group add-item-full">
          <label class="form-label" for="ai-specs">Specs (one "Key: Value" per line)</label>
          <textarea class="form-input" id="ai-specs" rows="3" placeholder="Power: 200W&#10;Type: Stereo mixing keyboard amp"></textarea>
        </div>
      </div>
      <label class="add-item-featured">
        <input type="checkbox" id="ai-featured" /> Show in "Featured" section on the homepage
      </label>
      <p id="add-item-error" class="add-item-error" hidden></p>
      <div class="add-item-actions">
        <button type="button" class="btn-primary" id="add-item-save">Save item</button>
        <button type="button" class="btn-secondary" id="add-item-cancel">Cancel</button>
      </div>
    </div>

    <p id="equipment-loading" class="loading-note">Loading equipment…</p>
    <div id="equipment-grid" class="equipment-grid" style="display:none;"></div>

    <!-- Edit item modal -->
    <div class="edit-modal-backdrop" id="edit-modal-backdrop" hidden>
      <div class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
        <button type="button" class="edit-modal-close" id="edit-modal-close" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <h2 id="edit-modal-title" class="add-item-title">Edit Item</h2>
        <div class="add-item-grid">
          <div class="form-group">
            <label class="form-label" for="ei-name">Name *</label>
            <input class="form-input" type="text" id="ei-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="ei-brand">Brand *</label>
            <input class="form-input" type="text" id="ei-brand" />
          </div>
          <div class="form-group">
            <label class="form-label" for="ei-category">Category *</label>
            <select class="form-input" id="ei-category"></select>
          </div>
          <div class="form-group">
            <label class="form-label" for="ei-subcategory">Subcategory *</label>
            <input class="form-input" type="text" id="ei-subcategory" />
          </div>
          <div class="form-group">
            <label class="form-label" for="ei-price">Price per day (₹) *</label>
            <input class="form-input" type="number" id="ei-price" min="1" />
          </div>
          <div class="form-group">
            <label class="form-label" for="ei-min-days">Minimum rental days *</label>
            <input class="form-input" type="number" id="ei-min-days" min="1" />
          </div>
          <div class="form-group add-item-full">
            <label class="form-label" for="ei-image">Image URL (optional)</label>
            <input class="form-input" type="text" id="ei-image" placeholder="/images/equipment/..." />
          </div>
          <div class="form-group add-item-full">
            <label class="form-label" for="ei-included">What's included (one per line)</label>
            <textarea class="form-input" id="ei-included" rows="3"></textarea>
          </div>
          <div class="form-group add-item-full">
            <label class="form-label" for="ei-specs">Specs (one "Key: Value" per line)</label>
            <textarea class="form-input" id="ei-specs" rows="3"></textarea>
          </div>
        </div>
        <label class="add-item-featured">
          <input type="checkbox" id="ei-featured" /> Show in "Featured" section on the homepage
        </label>
        <p id="edit-modal-error" class="add-item-error" hidden></p>
        <div class="add-item-actions">
          <button type="button" class="btn-primary" id="edit-modal-save">Save changes</button>
          <button type="button" class="btn-secondary" id="edit-modal-cancel">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container { max-width: 1280px; margin: 0 auto; padding: 32px 16px 80px; }
  .admin-tabs { display: flex; gap: 8px; margin-bottom: 20px; }
  .admin-tab {
    font-size: 13px; font-weight: 600; color: var(--color-mute); text-decoration: none;
    padding: 6px 14px; border-radius: var(--radius-full); border: 1px solid var(--color-hairline);
  }
  .admin-tab.active { color: var(--color-on-primary); background-color: var(--color-ink); border-color: var(--color-ink); }
  .page-sub { color: var(--color-mute); font-size: 14px; margin: 0 0 24px; max-width: 560px; }
  .loading-note { color: var(--color-mute); font-size: 14px; }

  .page-header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

  .add-item-panel {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg);
    padding: 20px; margin: 20px 0; max-width: 720px;
  }
  .add-item-title { font-size: 15px; font-weight: 600; margin: 0 0 16px; }
  .add-item-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .add-item-full { grid-column: 1 / -1; }
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 0; }
  .form-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans); height: 38px; padding: 0 10px; width: 100%;
  }
  textarea.form-input { height: auto; padding: 8px 10px; resize: vertical; }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .add-item-featured { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-body); margin-top: 14px; }
  .add-item-error { font-size: 13px; color: var(--color-error); margin: 12px 0 0; }
  .add-item-actions { display: flex; gap: 10px; margin-top: 18px; }
  @media (max-width: 640px) {
    .add-item-grid { grid-template-columns: 1fr; }
  }

  .edit-modal-backdrop {
    position: fixed; inset: 0; z-index: 500;
    background-color: rgba(0,0,0,0.55); backdrop-filter: blur(2px);
    display: flex; align-items: center; justify-content: center; padding: 20px;
  }
  .edit-modal {
    position: relative; width: 100%; max-width: 640px; max-height: 90vh; overflow-y: auto;
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); padding: 28px 24px 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
  }
  .edit-modal-close {
    position: absolute; top: 14px; right: 14px;
    background: none; border: none; color: var(--color-mute); cursor: pointer; padding: 4px;
  }
  .edit-modal-close:hover { color: var(--color-ink); }
</style>

<style is:global>
  .equipment-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px; margin-top: 20px;
  }
  .eq-card {
    background-color: var(--color-canvas); border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); padding: 16px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .eq-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .eq-name { font-size: 14px; font-weight: 600; color: var(--color-ink); margin: 0; }
  .eq-edit-btn {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    background: none; color: var(--color-mute); cursor: pointer;
  }
  .eq-edit-btn:hover { color: var(--color-ink); border-color: var(--color-hairline-strong); }
  .eq-sub { font-size: 12px; color: var(--color-mute); margin: 0; }
  .eq-price-display { font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 2px 0 0; }
  .eq-price-unit { font-size: 12px; font-weight: 400; color: var(--color-mute); }
  .eq-units-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
  .eq-units-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-mute); }
  .eq-stepper {
    display: flex; align-items: center; gap: 0;
    border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .eq-stepper-btn {
    width: 30px; height: 34px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    font-size: 16px; color: var(--color-ink);
    transition: background-color 0.12s;
  }
  .eq-stepper-btn:hover:not(:disabled) { background-color: var(--color-canvas-soft-2); }
  .eq-stepper-btn:disabled { color: var(--color-mute); cursor: not-allowed; opacity: 0.4; }
  .eq-stepper-value { min-width: 32px; text-align: center; font-size: 15px; font-weight: 600; color: var(--color-ink); }
  .eq-save-status { font-size: 11px; color: var(--color-mute); }
  .eq-save-status.saved { color: var(--color-accent-deep); }
  .eq-save-status.error { color: var(--color-error); }
  .eq-remove-btn {
    align-self: flex-start; font-size: 11px; color: var(--color-mute); background: none; border: none;
    cursor: pointer; padding: 2px 0; margin-top: 2px; text-decoration: underline;
  }
  .eq-remove-btn:hover { color: var(--color-error); }
  .eq-remove-btn:disabled { cursor: not-allowed; opacity: 0.6; }
</style>

<script>
  let equipmentList: any[] = [];

  async function loadEquipment() {
    const res = await fetch('/api/admin/equipment');
    if (res.status === 401) {
      window.location.href = '/admin/login?redirect=' + encodeURIComponent('/admin/equipment');
      return;
    }

    const data = await res.json();
    equipmentList = data.equipment;
    document.getElementById('equipment-loading')!.style.display = 'none';

    const grid = document.getElementById('equipment-grid')!;
    grid.innerHTML = data.equipment.map((item: any) => `
      <div class="eq-card">
        <div class="eq-card-header">
          <p class="eq-name">${item.name}</p>
          <button type="button" class="eq-edit-btn" data-slug="${item.slug}" aria-label="Edit item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
          </button>
        </div>
        <p class="eq-sub">${item.brand} · ${item.subcategory} · ${item.available ? 'Available' : 'Unavailable'}</p>
        <p class="eq-price-display">₹${item.pricePerDay.toLocaleString('en-IN')}<span class="eq-price-unit">/day</span></p>
        <div class="eq-units-row">
          <label class="eq-units-label">Units owned</label>
          <div class="eq-stepper" data-slug="${item.slug}">
            <button type="button" class="eq-stepper-btn" data-delta="-1" aria-label="Decrease units">−</button>
            <span class="eq-stepper-value" data-value="${item.totalUnits ?? 0}">${item.totalUnits ?? 0}</span>
            <button type="button" class="eq-stepper-btn" data-delta="1" aria-label="Increase units">+</button>
          </div>
        </div>
        <span class="eq-save-status" data-slug-status="${item.slug}"></span>
        <button type="button" class="eq-remove-btn" data-slug="${item.slug}" data-name="${item.name.replace(/"/g, '&quot;')}">Remove item</button>
      </div>
    `).join('');

    async function saveUnits(slug: string, valueEl: HTMLSpanElement, newUnits: number) {
      const statusEl = grid.querySelector<HTMLSpanElement>(`[data-slug-status="${slug}"]`)!;
      const previousValue = Number(valueEl.dataset.value);

      statusEl.textContent = 'Saving…';
      statusEl.className = 'eq-save-status';
      valueEl.textContent = String(newUnits);

      try {
        const res = await fetch('/api/admin/equipment/units', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, total_units: newUnits }),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) {
          statusEl.textContent = result.error || 'Could not save.';
          statusEl.className = 'eq-save-status error';
          valueEl.textContent = String(previousValue);
        } else {
          valueEl.dataset.value = String(newUnits);
          statusEl.textContent = 'Saved';
          statusEl.className = 'eq-save-status saved';
        }
      } catch {
        statusEl.textContent = 'Network error.';
        statusEl.className = 'eq-save-status error';
        valueEl.textContent = String(previousValue);
      }
    }

    grid.querySelectorAll<HTMLButtonElement>('.eq-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => openEditModal(btn.dataset.slug!));
    });

    grid.querySelectorAll<HTMLDivElement>('.eq-stepper').forEach((stepper) => {
      const slug = stepper.dataset.slug!;
      const valueEl = stepper.querySelector<HTMLSpanElement>('.eq-stepper-value')!;

      stepper.querySelectorAll<HTMLButtonElement>('.eq-stepper-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const delta = Number(btn.dataset.delta);
          const current = Number(valueEl.dataset.value);
          const newUnits = Math.max(0, current + delta);
          if (newUnits === current) return;

          stepper.querySelectorAll('button').forEach(b => (b as HTMLButtonElement).disabled = true);
          await saveUnits(slug, valueEl, newUnits);
          stepper.querySelectorAll('button').forEach(b => (b as HTMLButtonElement).disabled = false);
        });
      });
    });

    grid.querySelectorAll<HTMLButtonElement>('.eq-remove-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug!;
        const name = btn.dataset.name!;
        if (!confirm(`Remove "${name}"? This can't be undone.`)) return;

        btn.disabled = true;
        btn.textContent = 'Removing…';
        try {
          const res = await fetch('/api/admin/equipment/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const result = await res.json();
          if (!res.ok || !result.ok) {
            alert(result.error || 'Could not remove this item.');
            btn.disabled = false;
            btn.textContent = 'Remove item';
            return;
          }
          btn.closest('.eq-card')!.remove();
        } catch {
          alert('Network error — please try again.');
          btn.disabled = false;
          btn.textContent = 'Remove item';
        }
      });
    });

    grid.style.display = 'grid';
  }

  loadEquipment();

  // Add new item
  interface CategoryOption { slug: string; name: string; }
  const categoryOptions: CategoryOption[] = JSON.parse(
    document.getElementById('admin-categories-data')!.textContent!
  );
  const categorySelect = document.getElementById('ai-category') as HTMLSelectElement;
  categorySelect.innerHTML = categoryOptions.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');

  const addItemToggle = document.getElementById('add-item-toggle') as HTMLButtonElement;
  const addItemPanel = document.getElementById('add-item-panel') as HTMLDivElement;
  const addItemError = document.getElementById('add-item-error') as HTMLParagraphElement;
  const addItemSaveBtn = document.getElementById('add-item-save') as HTMLButtonElement;

  function parseLines(text: string): string[] {
    return text.split('\n').map(l => l.trim()).filter(Boolean);
  }
  function parseSpecs(text: string): Record<string, string> {
    const specs: Record<string, string> = {};
    for (const line of parseLines(text)) {
      const [key, ...rest] = line.split(':');
      if (key && rest.length) specs[key.trim()] = rest.join(':').trim();
    }
    return specs;
  }
  function resetAddItemForm() {
    (document.getElementById('ai-name') as HTMLInputElement).value = '';
    (document.getElementById('ai-brand') as HTMLInputElement).value = '';
    (document.getElementById('ai-subcategory') as HTMLInputElement).value = '';
    (document.getElementById('ai-price') as HTMLInputElement).value = '';
    (document.getElementById('ai-min-days') as HTMLInputElement).value = '1';
    (document.getElementById('ai-units') as HTMLInputElement).value = '1';
    (document.getElementById('ai-image') as HTMLInputElement).value = '';
    (document.getElementById('ai-included') as HTMLTextAreaElement).value = '';
    (document.getElementById('ai-specs') as HTMLTextAreaElement).value = '';
    (document.getElementById('ai-featured') as HTMLInputElement).checked = false;
    addItemError.hidden = true;
  }

  addItemToggle.addEventListener('click', () => {
    addItemPanel.hidden = !addItemPanel.hidden;
    if (!addItemPanel.hidden) resetAddItemForm();
  });
  document.getElementById('add-item-cancel')!.addEventListener('click', () => {
    addItemPanel.hidden = true;
  });

  addItemSaveBtn.addEventListener('click', async () => {
    const name = (document.getElementById('ai-name') as HTMLInputElement).value.trim();
    const brand = (document.getElementById('ai-brand') as HTMLInputElement).value.trim();
    const category = categorySelect.value;
    const subcategory = (document.getElementById('ai-subcategory') as HTMLInputElement).value.trim();
    const pricePerDay = Number((document.getElementById('ai-price') as HTMLInputElement).value);
    const minDays = Number((document.getElementById('ai-min-days') as HTMLInputElement).value);
    const totalUnits = Number((document.getElementById('ai-units') as HTMLInputElement).value);
    const image = (document.getElementById('ai-image') as HTMLInputElement).value.trim();
    const included = parseLines((document.getElementById('ai-included') as HTMLTextAreaElement).value);
    const specs = parseSpecs((document.getElementById('ai-specs') as HTMLTextAreaElement).value);
    const featured = (document.getElementById('ai-featured') as HTMLInputElement).checked;

    addItemError.hidden = true;
    if (!name || !brand || !subcategory) {
      addItemError.textContent = 'Name, brand, and subcategory are required.';
      addItemError.hidden = false;
      return;
    }
    if (!Number.isInteger(pricePerDay) || pricePerDay <= 0) {
      addItemError.textContent = 'Enter a valid price per day.';
      addItemError.hidden = false;
      return;
    }

    addItemSaveBtn.disabled = true;
    addItemSaveBtn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/admin/equipment/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, brand, category, subcategory, pricePerDay, minDays, totalUnits, included, specs, image, featured,
        }),
      });
      const result = await res.json();
      if (!res.ok || !result.ok) {
        addItemError.textContent = result.error || 'Could not save this item.';
        addItemError.hidden = false;
      } else {
        addItemPanel.hidden = true;
        document.getElementById('equipment-loading')!.style.display = 'block';
        document.getElementById('equipment-grid')!.style.display = 'none';
        await loadEquipment();
      }
    } catch {
      addItemError.textContent = 'Network error — please try again.';
      addItemError.hidden = false;
    }
    addItemSaveBtn.disabled = false;
    addItemSaveBtn.textContent = 'Save item';
  });

  // Edit item modal
  const editBackdrop = document.getElementById('edit-modal-backdrop') as HTMLDivElement;
  const editCategorySelect = document.getElementById('ei-category') as HTMLSelectElement;
  editCategorySelect.innerHTML = categoryOptions.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');
  const editError = document.getElementById('edit-modal-error') as HTMLParagraphElement;
  const editSaveBtn = document.getElementById('edit-modal-save') as HTMLButtonElement;
  let editingSlug = '';

  function openEditModal(slug: string) {
    const item = equipmentList.find((i) => i.slug === slug);
    if (!item) return;
    editingSlug = slug;

    (document.getElementById('ei-name') as HTMLInputElement).value = item.name;
    (document.getElementById('ei-brand') as HTMLInputElement).value = item.brand;
    editCategorySelect.value = item.category;
    (document.getElementById('ei-subcategory') as HTMLInputElement).value = item.subcategory;
    (document.getElementById('ei-price') as HTMLInputElement).value = String(item.pricePerDay);
    (document.getElementById('ei-min-days') as HTMLInputElement).value = String(item.minDays);
    (document.getElementById('ei-image') as HTMLInputElement).value = item.image ?? '';
    (document.getElementById('ei-included') as HTMLTextAreaElement).value = (item.included ?? []).join('\n');
    (document.getElementById('ei-specs') as HTMLTextAreaElement).value = Object.entries(item.specs ?? {})
      .map(([k, v]) => `${k}: ${v}`).join('\n');
    (document.getElementById('ei-featured') as HTMLInputElement).checked = Boolean(item.featured);
    editError.hidden = true;

    editBackdrop.hidden = false;
  }
  function closeEditModal() {
    editBackdrop.hidden = true;
    editingSlug = '';
  }

  document.getElementById('edit-modal-close')!.addEventListener('click', closeEditModal);
  document.getElementById('edit-modal-cancel')!.addEventListener('click', closeEditModal);
  editBackdrop.addEventListener('click', (e) => {
    if (e.target === editBackdrop) closeEditModal();
  });

  editSaveBtn.addEventListener('click', async () => {
    const name = (document.getElementById('ei-name') as HTMLInputElement).value.trim();
    const brand = (document.getElementById('ei-brand') as HTMLInputElement).value.trim();
    const category = editCategorySelect.value;
    const subcategory = (document.getElementById('ei-subcategory') as HTMLInputElement).value.trim();
    const pricePerDay = Number((document.getElementById('ei-price') as HTMLInputElement).value);
    const minDays = Number((document.getElementById('ei-min-days') as HTMLInputElement).value);
    const image = (document.getElementById('ei-image') as HTMLInputElement).value.trim();
    const included = parseLines((document.getElementById('ei-included') as HTMLTextAreaElement).value);
    const specs = parseSpecs((document.getElementById('ei-specs') as HTMLTextAreaElement).value);
    const featured = (document.getElementById('ei-featured') as HTMLInputElement).checked;

    editError.hidden = true;
    if (!name || !brand || !subcategory) {
      editError.textContent = 'Name, brand, and subcategory are required.';
      editError.hidden = false;
      return;
    }
    if (!Number.isInteger(pricePerDay) || pricePerDay <= 0) {
      editError.textContent = 'Enter a valid price per day.';
      editError.hidden = false;
      return;
    }

    editSaveBtn.disabled = true;
    editSaveBtn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/admin/equipment/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug: editingSlug, name, brand, category, subcategory, pricePerDay, minDays, included, specs, image, featured,
        }),
      });
      const result = await res.json();
      if (!res.ok || !result.ok) {
        editError.textContent = result.error || 'Could not save this item.';
        editError.hidden = false;
      } else {
        closeEditModal();
        document.getElementById('equipment-loading')!.style.display = 'block';
        document.getElementById('equipment-grid')!.style.display = 'none';
        await loadEquipment();
      }
    } catch {
      editError.textContent = 'Network error — please try again.';
      editError.hidden = false;
    }
    editSaveBtn.disabled = false;
    editSaveBtn.textContent = 'Save changes';
  });
</script>
