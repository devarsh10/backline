---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Orders" noIndex={true}>
  <div class="page-container">
    <h1 class="display-lg">Orders</h1>
    <p id="orders-loading" class="loading-note">Loading orders…</p>
    <div id="orders-table-wrap" style="display:none;">
      <table class="orders-table">
        <thead>
          <tr>
            <th>Order Ref</th>
            <th>Customer</th>
            <th>Contact</th>
            <th>City</th>
            <th>Items</th>
            <th>Dates</th>
            <th>Total</th>
            <th>Status</th>
            <th>Placed</th>
          </tr>
        </thead>
        <tbody id="orders-tbody"></tbody>
      </table>
    </div>
    <p id="orders-empty" class="loading-note" style="display:none;">No orders yet.</p>
  </div>
</Layout>

<style>
  .page-container { max-width: 1280px; margin: 0 auto; padding: 32px 24px 80px; }
  .loading-note { color: var(--color-mute); font-size: 14px; }
  .orders-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 20px; }
  .orders-table th {
    text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--color-hairline);
    color: var(--color-mute); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .orders-table td {
    padding: 10px 12px; border-bottom: 1px solid var(--color-hairline); color: var(--color-body); vertical-align: top;
  }
  .orders-table tr:hover { background-color: var(--color-canvas-soft-2); }
  .status-badge { display: inline-block; padding: 2px 8px; border-radius: var(--radius-full); font-size: 11px; font-weight: 500; white-space: nowrap; }
  .status-order_placed { background-color: var(--color-canvas-soft-2); color: var(--color-mute); }
  .status-payment_received { background-color: var(--color-accent-soft); color: var(--color-accent-deep); }
</style>

<script>
  async function loadOrders() {
    const res = await fetch('/api/admin/orders');
    if (res.status === 401) {
      window.location.href = '/admin/login?redirect=' + encodeURIComponent('/admin/orders');
      return;
    }

    const data = await res.json();
    document.getElementById('orders-loading')!.style.display = 'none';

    if (!data.ok || !data.orders.length) {
      document.getElementById('orders-empty')!.style.display = 'block';
      return;
    }

    const tbody = document.getElementById('orders-tbody')!;
    tbody.innerHTML = data.orders.map((o: any) => {
      const items = JSON.parse(o.items_json).map((l: any) => `${l.name} ×${l.quantity}`).join(', ');
      const placed = new Date(o.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      return `
        <tr>
          <td>${o.order_ref}</td>
          <td>${o.customer_name}</td>
          <td>${o.customer_phone}<br/>${o.customer_email}</td>
          <td>${o.city}</td>
          <td>${items}</td>
          <td>${o.rental_start_date} → ${o.rental_end_date}</td>
          <td>₹${o.total_amount.toLocaleString('en-IN')}</td>
          <td><span class="status-badge status-${o.status}">${o.status.replace(/_/g, ' ')}</span></td>
          <td>${placed}</td>
        </tr>
      `;
    }).join('');
    document.getElementById('orders-table-wrap')!.style.display = 'block';
  }

  loadOrders();
</script>
