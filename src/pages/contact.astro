---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import { generalFaq, paymentFaq } from '../data/faq';
---

<Layout
  title="Contact Us"
  description="Get in touch with Backline India. Phone, email, or send us a message."
>
  <div class="page-container">
    <div class="page-header">
      <span class="caption-mono" style="color: var(--color-mute); display: block; margin-bottom: 12px;">Get in touch</span>
      <h1 class="display-xl page-title">Questions? We're here.</h1>
      <p class="body-lg page-sub">Need help building your cart, have a question about a specific item, or want a custom package built for your event — just reach out.</p>
    </div>

    <div class="contact-layout">
      <div class="contact-main">
        <!-- Message form -->
        <div class="message-card">
          <h2 class="message-title">Send a message</h2>
          <p class="message-sub">For custom package requests, outstation events, or anything else — just tell us what you need.</p>

          <form class="message-form" id="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="c-name">Your name *</label>
                <input class="form-input" type="text" id="c-name" name="name" placeholder="Arjun Sharma" required autocomplete="name" />
              </div>
              <div class="form-group">
                <label class="form-label" for="c-phone">Phone *</label>
                <input class="form-input" type="tel" id="c-phone" name="phone" placeholder="+91 98765 43210" required autocomplete="tel" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="c-email">Email</label>
              <input class="form-input" type="email" id="c-email" name="email" placeholder="arjun@example.com" autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label" for="c-message">Message *</label>
              <textarea
                class="form-input form-textarea"
                id="c-message"
                name="message"
                rows="4"
                required
                placeholder="Tell us about your event, what gear you need, your city and dates…"
              ></textarea>
            </div>
            <p id="contact-error" class="contact-form-error" style="display:none;"></p>
            <button type="submit" class="btn-primary" id="contact-submit-btn" style="width: 100%; justify-content: center;">Send message</button>
          </form>
        </div>
      </div>

      <!-- Sidebar info -->
      <aside class="contact-sidebar">
        <div class="info-card">
          <h3 class="info-card-title caption-mono">Contact details</h3>
          <div class="info-list">
            <div class="info-row">
              <span class="info-label">Phone</span>
              <a href="tel:+917600393515" class="info-value">+91 7600 393 515</a>
            </div>
            <div class="info-row">
              <span class="info-label">Email</span>
              <a href="mailto:hello@backlineindia.com" class="info-value">hello@backlineindia.com</a>
            </div>
            <div class="info-row">
              <span class="info-label">Hours</span>
              <span class="info-value">Mon–Sat, 9 AM–8 PM IST</span>
            </div>
          </div>
          <p class="service-area-note">We deliver across Gujarat — Ahmedabad, Surat, Vadodara, Rajkot, and beyond, with outstation on request.</p>
        </div>
      </aside>
    </div>
  </div>

  <FAQ eyebrow="FAQ" groups={[{ heading: 'Common questions', items: [...generalFaq, ...paymentFaq] }]} />
</Layout>

<style>
  .page-container { max-width: 1280px; margin: 0 auto; padding: 0 24px 80px; }
  .page-header { padding: 60px 0 48px; max-width: 680px; }
  .page-title { margin: 0 0 16px; }
  .page-sub { color: var(--color-body); margin: 0; }

  .contact-layout { display: grid; grid-template-columns: 1fr 320px; gap: 40px; align-items: start; }
  .contact-main { display: flex; flex-direction: column; gap: 16px; }

  .message-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline); border-radius: var(--radius-lg);
    padding: 28px;
  }
  .message-title { font-size: 18px; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 4px; }
  .message-sub { font-size: 14px; color: var(--color-mute); margin: 0 0 20px; }
  .message-form { display: flex; flex-direction: column; gap: 14px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-label { font-size: 12px; font-weight: 500; color: var(--color-body); }
  .form-input {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline); border-radius: var(--radius-sm);
    color: var(--color-ink); font-size: 14px; font-family: var(--font-sans);
    height: 40px; padding: 0 12px;
    transition: border-color 0.15s; width: 100%;
  }
  .form-input:focus { border-color: var(--color-ink); outline: none; }
  .form-textarea { height: auto; padding: 10px 12px; resize: vertical; line-height: 1.5; }

  .contact-sidebar { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 76px; }
  .info-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline); border-radius: var(--radius-md);
    padding: 18px;
  }
  .info-card-title { color: var(--color-mute); display: block; margin-bottom: 12px; }
  .info-list { display: flex; flex-direction: column; gap: 10px; }
  .info-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .info-label { font-size: 12px; color: var(--color-mute); flex-shrink: 0; }
  .info-value { font-size: 13px; color: var(--color-ink); font-weight: 500; text-align: right; text-decoration: none; }
  a.info-value:hover { color: var(--color-link); }
  .service-area-note {
    font-size: 12.5px; color: var(--color-mute); line-height: 1.6;
    margin: 14px 0 0; padding-top: 14px; border-top: 1px solid var(--color-hairline);
  }

  @media (max-width: 960px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; }
  }
  @media (max-width: 560px) {
    .page-container { padding: 0 16px 60px; }
    .page-header { padding: 40px 0 32px; }
    .message-card { padding: 20px 16px; }
    .form-row { grid-template-columns: 1fr; }
  }
  .contact-form-error { font-size: 13px; color: var(--color-error); margin: -4px 0 0; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const errorEl = document.getElementById('contact-error')!;
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('c-phone') as HTMLInputElement).value.trim();
    const email = (document.getElementById('c-email') as HTMLInputElement).value.trim();
    const message = (document.getElementById('c-message') as HTMLTextAreaElement).value.trim();

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, phone, email, message }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        errorEl.textContent = data.error || 'Could not send your message. Please try again.';
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Send message';
        return;
      }
      window.location.href = '/contact-success';
    } catch {
      errorEl.textContent = 'Network error. Please try again.';
      errorEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
