{
  "name": "hem-backline",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "backlineindia.com", "custom_domain": true },
    { "pattern": "www.backlineindia.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hem-backline-db",
      "database_id": "b425b8b9-9c91-4dbb-bb3c-5f5dbccb41f1"
    }
  ],
  "vars": {
    "EMAIL_ENABLED": "true",
    "RESEND_FROM_EMAIL": "Backline India <admin@backlineindia.com>"
  },
  "observability": {
    "enabled": true
  }
}
